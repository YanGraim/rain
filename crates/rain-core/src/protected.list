# Built-in protection list. One absolute path per line; `~/` is below the
# canonical home. A protected path covers everything below it. Matching
# ignores case and Unicode normalization (see `normalize`).

# System and shared locations.
/System
/usr
/bin
/sbin
/private
/etc
/var
/tmp
/dev
/cores
/opt
/Library
/Applications
/Volumes

# User data and credentials.
~/.ssh
~/.gnupg
~/.aws
~/.kube
~/.config/gcloud
~/.docker
~/.password-store
~/Documents
~/Desktop
~/Downloads
~/Applications
~/Pictures/Photos Library.photoslibrary

# Apple data, cloud sync and device backups.
~/Library/Keychains
~/Library/Photos
~/Library/Mail
~/Library/Messages
~/Library/Safari
~/Library/Cookies
~/Library/Notes
~/Library/Mobile Documents
~/Library/CloudStorage
~/Library/Group Containers
~/Library/Containers/com.apple.mail
~/Library/Containers/com.apple.Photos
~/Library/Application Support/MobileSync
~/Library/Application Support/AddressBook
~/Library/Application Support/Calendars
~/Library/Caches/CloudKit
~/Library/Caches/com.apple.bird
~/Library/Caches/docker-secrets-engine
# Poetry project virtualenvs live under Caches but are environments, not cache.
~/Library/Caches/pypoetry/virtualenvs
# hatch and pdm keep their environments outside Caches by default, but their
# config can point them here. An environment is the user's work, not cache,
# so these are protected, and a candidate that holds them (`hatch`, `pdm`) is
# refused whole.
~/Library/Caches/hatch/env
~/Library/Caches/pdm/venvs
# JetBrains IDEs keep the local history of edited files (the user's work) under
# <Product><Version>/LocalHistory. This format has no wildcard in the middle of a
# path, so the whole folder is protected, and refused whole as a candidate.
~/Library/Caches/JetBrains
# Downloads in flight (URLSession background transfers) are kept by the
# system until they finish; removing them breaks the transfer.
~/Library/Caches/com.apple.nsurlsessiond

# Developer tools: next to their caches these hold binaries, configuration and
# credentials (Cargo registry tokens, Maven server passwords). The cache rules
# name only their cache folders; these are kept even for a root the user gives.
~/.cargo/bin
~/.cargo/config
~/.cargo/config.toml
~/.cargo/credentials
~/.cargo/credentials.toml
~/.m2/settings.xml

# The Trash: what was already moved out of the way, never an item (and the
# executor must not move anything into itself).
~/.Trash

# Container engines: VM disks and data, cleaned only by the engine itself.
# Docker's group container is already covered by ~/Library/Group Containers.
~/Library/Containers/com.docker.docker
~/.orbstack
~/.colima
# Lima VMs and their SSH private key (_config/user).
~/.lima
# Podman config, including registry credentials (auth.json).
~/.config/containers
~/Library/Application Support/rancher-desktop
~/.rd
~/.local/share/containers

# Password managers and wallets.
~/Library/Application Support/1Password
~/Library/Application Support/Bitwarden
~/Library/Application Support/Bitcoin
~/Library/Application Support/Ethereum
~/Library/Application Support/Electrum
~/Library/Application Support/Exodus

# Password-manager caches (FR-044): sys.user-caches lists every child of
# ~/Library/Caches, so these must never be candidates.
~/Library/Caches/com.1password.1password
~/Library/Caches/com.agilebits.onepassword7
~/Library/Caches/2BUA8C4S2C.com.1password
~/Library/Caches/com.bitwarden.desktop
~/Library/Caches/com.lastpass.LastPass
~/Library/Caches/com.dashlane.Dashlane
~/Library/Caches/in.sinew.Enpass-Desktop
~/Library/Caches/org.keepassxc.keepassxc
# More managers, exact bundle ids only (no prefix entries in this format):
# Proton Pass (desktop), Strongbox (macOS), MacPass, KeePassium, Keeper
# (desktop and Mac App Store).
~/Library/Caches/me.proton.pass.electron
~/Library/Caches/com.markmcguill.strongbox.mac
~/Library/Caches/com.hicknhacksoftware.MacPass
~/Library/Caches/com.keepassium.ios
~/Library/Caches/com.keepersecurity.passwordmanager
~/Library/Caches/com.callpod.keepermac.lite
# Exist per their vendors' catalogue, not confirmed to write to Caches:
# protected as a precaution (when in doubt, protect).
~/Library/Caches/me.proton.pass.catalyst
~/Library/Caches/com.markmcguill.strongbox
~/Library/Caches/com.markmcguill.strongbox.pro
~/Library/Caches/com.markmcguill.strongbox.graphene
~/Library/Caches/com.keepassium.ios.pro
~/Library/Caches/com.keepersecurity.safari.keeperfill
# Exact ids from the Homebrew cask stanzas (zap or uninstall quit): LastPass,
# KeePassXC (its older id, besides org.keepassxc.keepassxc), RoboForm, NordPass.
# The NordPass updater cache and the wildcard variants stay out (no prefixes).
~/Library/Caches/com.lastpass.lastpassmacdesktop
~/Library/Caches/org.keepassx.keepassxc
~/Library/Caches/com.SiberSystems.RoboForm
~/Library/Caches/com.SiberSystems.RoboForm.RoboFormService
~/Library/Caches/com.sibersystems.RoboFormMac
~/Library/Caches/com.nordsec.nordpass

# Claude Code user data: config, credentials, sessions and history.
# ~/.claude itself stays open so the cache and debug log rules still work.
~/.claude.json
~/.claude/.credentials.json
~/.claude/settings.json
~/.claude/settings.local.json
~/.claude/projects
~/.claude/history.jsonl
~/.claude/todos
~/.claude/file-history
~/.claude/sessions
~/.claude/plans
~/.claude/backups
# User-authored instructions, agents, commands, skills, plugins and hooks.
~/.claude/CLAUDE.md
~/.claude/agents
~/.claude/commands
~/.claude/skills
~/.claude/plugins
~/.claude/hooks
~/.claude/output-styles
~/.claude/session-env
~/.claude.json.backup

# AI tool credentials (OAuth tokens).
~/.config/github-copilot/hosts.json
~/.config/github-copilot/apps.json
~/.codex/auth.json

# Cursor and VS Code chat history and editor state, with the WAL, SHM and
# journal files of the live database and the agent and search databases next to
# it (backups next to it are not covered).
~/Library/Application Support/Cursor/User/globalStorage/state.vscdb
~/Library/Application Support/Cursor/User/globalStorage/state.vscdb-wal
~/Library/Application Support/Cursor/User/globalStorage/state.vscdb-shm
~/Library/Application Support/Cursor/User/globalStorage/state.vscdb-journal
~/Library/Application Support/Cursor/User/globalStorage/agent-host.db
~/Library/Application Support/Cursor/User/globalStorage/conversation-search.db
~/Library/Application Support/Code/User/globalStorage/state.vscdb
~/Library/Application Support/Code/User/globalStorage/state.vscdb-wal
~/Library/Application Support/Code/User/globalStorage/state.vscdb-shm
~/Library/Application Support/Code/User/globalStorage/state.vscdb-journal
~/Library/Application Support/Code/User/globalStorage/agent-host.db
~/Library/Application Support/Code/User/globalStorage/conversation-search.db

# Claude app VM: session data and machine identity (owner decision).
~/Library/Application Support/Claude/vm_bundles
~/Library/Application Support/Claude/vm_bundles/claudevm.bundle/sessiondata.img
~/Library/Application Support/Claude/vm_bundles/claudevm.bundle/machineIdentifier
~/Library/Application Support/Claude/vm_bundles/claudevm.bundle/gvisorMacAddress
~/Library/Application Support/Claude/vm_bundles/claudevm.bundle/vmIP
~/Library/Application Support/Claude/vm_bundles/claudevm.bundle/.cowork-adopted
