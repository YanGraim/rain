# Built-in protection list. One absolute path per line; `~/` is below the
# canonical home. A protected path covers everything below it. Matching
# ignores case and Unicode normalization (see `normalize`).

# System and shared locations.
/System
/usr
/bin
/sbin
/private
/etc
/var
/tmp
/dev
/cores
/opt
/Library
/Applications
/Volumes

# User data and credentials.
~/.ssh
~/.gnupg
~/.aws
~/.kube
~/.config/gcloud
~/.docker
~/.password-store
~/Documents
~/Desktop
~/Downloads
~/Applications
~/Pictures/Photos Library.photoslibrary

# Apple data, cloud sync and device backups.
~/Library/Keychains
~/Library/Photos
~/Library/Mail
~/Library/Messages
~/Library/Safari
~/Library/Cookies
~/Library/Notes
~/Library/Mobile Documents
~/Library/CloudStorage
~/Library/Group Containers
~/Library/Containers/com.apple.mail
~/Library/Containers/com.apple.Photos
~/Library/Application Support/MobileSync
~/Library/Application Support/AddressBook
~/Library/Application Support/Calendars
~/Library/Caches/CloudKit
~/Library/Caches/com.apple.bird
~/Library/Caches/docker-secrets-engine
# Poetry project virtualenvs live under Caches but are environments, not cache.
~/Library/Caches/pypoetry/virtualenvs

# Container engines: VM disks and data, cleaned only by the engine itself.
# Docker's group container is already covered by ~/Library/Group Containers.
~/Library/Containers/com.docker.docker
~/.orbstack
~/.colima
# Lima VMs and their SSH private key (_config/user).
~/.lima
# Podman config, including registry credentials (auth.json).
~/.config/containers
~/Library/Application Support/rancher-desktop
~/.rd
~/.local/share/containers

# Password managers and wallets.
~/Library/Application Support/1Password
~/Library/Application Support/Bitwarden
~/Library/Application Support/Bitcoin
~/Library/Application Support/Ethereum
~/Library/Application Support/Electrum
~/Library/Application Support/Exodus

# Password-manager caches (FR-044): sys.user-caches lists every child of
# ~/Library/Caches, so these must never be candidates.
~/Library/Caches/com.1password.1password
~/Library/Caches/com.agilebits.onepassword7
~/Library/Caches/2BUA8C4S2C.com.1password
~/Library/Caches/com.bitwarden.desktop
~/Library/Caches/com.lastpass.LastPass
~/Library/Caches/com.dashlane.Dashlane
~/Library/Caches/in.sinew.Enpass-Desktop
~/Library/Caches/org.keepassxc.keepassxc

# Claude Code user data: config, credentials, sessions and history.
# ~/.claude itself stays open so the cache and debug log rules still work.
~/.claude.json
~/.claude/.credentials.json
~/.claude/settings.json
~/.claude/settings.local.json
~/.claude/projects
~/.claude/history.jsonl
~/.claude/todos
~/.claude/file-history
~/.claude/sessions
~/.claude/plans
~/.claude/backups
# User-authored instructions, agents, commands, skills, plugins and hooks.
~/.claude/CLAUDE.md
~/.claude/agents
~/.claude/commands
~/.claude/skills
~/.claude/plugins
~/.claude/hooks
~/.claude/output-styles
~/.claude/session-env
~/.claude.json.backup

# AI tool credentials (OAuth tokens).
~/.config/github-copilot/hosts.json
~/.config/github-copilot/apps.json
~/.codex/auth.json

# Cursor chat history and editor state (backups next to it are not covered).
~/Library/Application Support/Cursor/User/globalStorage/state.vscdb

# Claude app VM: session data and machine identity (owner decision).
~/Library/Application Support/Claude/vm_bundles
~/Library/Application Support/Claude/vm_bundles/claudevm.bundle/sessiondata.img
~/Library/Application Support/Claude/vm_bundles/claudevm.bundle/machineIdentifier
~/Library/Application Support/Claude/vm_bundles/claudevm.bundle/gvisorMacAddress
~/Library/Application Support/Claude/vm_bundles/claudevm.bundle/vmIP
~/Library/Application Support/Claude/vm_bundles/claudevm.bundle/.cowork-adopted
